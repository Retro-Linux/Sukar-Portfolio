---
/**
 * Contact.astro
 * ──────────────────────────────────────────
 * Minimal editorial contact form.
 * Pure Astro + HTML — no client JS needed.
 * All inputs have proper labels and focus states.
 */
interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;

import { useTranslations } from '../i18n/utils';
const t = useTranslations(lang);
---

<form
  class="contact-form"
  action="#"
  method="POST"
  aria-label="Contact form"
  id="contact-form"
>
  <!-- ── Name ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-name">{t('contact.field_name')}</label>
    <div class="contact-form__input-wrap">
      <input
        type="text"
        id="contact-name"
        name="name"
        class="contact-form__input"
        placeholder={t('contact.placeholder_name')}
        required
      />
    </div>
  </div>

  <!-- ── Email ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-email">{t('contact.field_email')}</label>
    <div class="contact-form__input-wrap">
      <input
        type="email"
        id="contact-email"
        name="email"
        class="contact-form__input"
        placeholder={t('contact.placeholder_email')}
        required
      />
    </div>
  </div>

  <!-- ── Subject ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-subject">{t('contact.field_subject')}</label>
    <div class="contact-form__input-wrap">
      <input
        type="text"
        id="contact-subject"
        name="subject"
        class="contact-form__input"
        placeholder={t('contact.placeholder_subject')}
        required
      />
    </div>
  </div>

  <!-- ── Message ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-message">{t('contact.field_message')}</label>
    <div class="contact-form__input-wrap">
      <textarea
        id="contact-message"
        name="message"
        class="contact-form__input contact-form__textarea"
        placeholder={t('contact.placeholder_message')}
        rows="5"
        required
      ></textarea>
    </div>
  </div>

  <!-- ── Honeypot (Hidden) ── -->
  <input type="text" name="favorite_color" style="display:none" tabindex="-1" autocomplete="off" />

  <!-- ── Turnstile Widget ── -->
  <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>

  <div class="contact-form__submit">
    <button type="submit" class="btn btn--primary" id="contact-submit-btn">
      {t('contact.btn_send_message')}
    </button>
  </div>

  <div id="contact-form-status" class="contact-form__status" aria-live="polite"></div>
</form>

<!-- ── Success Modal ── -->
<div id="success-modal" class="success-modal" aria-hidden="true">
  <div class="success-modal__content">
    <button id="success-modal-close" class="success-modal__close" aria-label="Close modal" type="button">×</button>
    <div class="success-modal__icon">💌</div>
    <h3 class="success-modal__title">Yay! Message Sent!</h3>
    <p class="success-modal__text">Thank you so much for reaching out! I've received your message and will get back to you as soon as I can.</p>
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusDiv = document.getElementById('contact-form-status');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
  const successModal = document.getElementById('success-modal');
  const closeModalBtn = document.getElementById('success-modal-close');

  if (closeModalBtn && successModal) {
    closeModalBtn.addEventListener('click', () => {
      successModal.classList.remove('is-visible');
    });
  }

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      
      // Basic client validation to check if Turnstile is complete
      const turnstileResponse = formData.get('cf-turnstile-response');
      if (!turnstileResponse) {
        statusDiv.textContent = 'Please complete the security check.';
        statusDiv.className = 'contact-form__status contact-form__status--error';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      statusDiv.textContent = '';
      statusDiv.className = 'contact-form__status';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (res.ok) {
          form.reset();
          if ((window as any).turnstile) (window as any).turnstile.reset();
          if (successModal) {
            successModal.classList.add('is-visible');
          }
          statusDiv.textContent = '';
          statusDiv.className = 'contact-form__status';
        } else {
          throw new Error(data.error || 'Failed to send message.');
        }
      } catch (err: any) {
        statusDiv.textContent = err.message || 'An error occurred. Please try again later.';
        statusDiv.className = 'contact-form__status contact-form__status--error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: 520px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contact-form__label {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .contact-form__input::placeholder,
  .contact-form__textarea::placeholder {
    color: var(--color-graphite);
    opacity: 0.6;
    font-weight: 300;
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus {
    border-color: var(--color-coral);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02), 0 0 0 3px rgba(244, 123, 137, 0.15);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form__submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2.5rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-cream);
    background: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, transparent 100%), var(--color-amber);
    border: 2px solid var(--color-amber);
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 2px 4px 0px rgba(212, 133, 58, 0.25), inset 0 1px 2px rgba(255,255,255,0.2);
    transition: all 0.3s var(--ease-spring);
  }

  .contact-form__submit:hover {
    transform: translateY(-2px) rotate(2deg);
    box-shadow: 2px 6px 0px rgba(212, 133, 58, 0.3), inset 0 1px 2px rgba(255,255,255,0.25);
  }

  .contact-form__submit:focus-visible {
    outline: 2px dashed var(--color-coral);
    outline-offset: 4px;
  }

  .contact-form__status {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
  }

  .contact-form__status--success {
    color: var(--color-sage);
  }

  .contact-form__status--error {
    color: var(--color-coral);
  }

  /* ── Success Modal ── */
  .success-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(253, 246, 237, 0.85);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .success-modal.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .success-modal__content {
    position: relative;
    background: var(--color-paper);
    padding: 2.5rem;
    border-radius: 16px;
    max-width: 400px;
    width: 90%;
    text-align: center;
    box-shadow: 0 10px 30px rgba(212, 133, 58, 0.15);
    border: 2px solid var(--color-coral);
    transform: translateY(20px) scale(0.95);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .success-modal.is-visible .success-modal__content {
    transform: translateY(0) scale(1);
  }

  .success-modal__close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: none;
    border: none;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-coral);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .success-modal__close:hover {
    transform: scale(1.2);
  }

  .success-modal__icon {
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
    animation: float 3s ease-in-out infinite;
  }

  .success-modal__title {
    font-family: var(--font-hand);
    font-size: 2.2rem;
    color: var(--color-coral);
    margin-bottom: 0.5rem;
  }

  .success-modal__text {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-ink);
    line-height: 1.5;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (max-width: 640px) {
    .contact-form__submit {
      width: 100%;
    }
  }
</style>
