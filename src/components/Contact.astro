---
/**
 * Contact.astro
 * ──────────────────────────────────────────
 * Minimal editorial contact form.
 * Pure Astro + HTML — no client JS needed.
 * All inputs have proper labels and focus states.
 */
interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;

import { useTranslations } from '../i18n/utils';
const t = useTranslations(lang);
---

<form
  class="contact-form"
  action="#"
  method="POST"
  aria-label="Contact form"
  id="contact-form"
>
  <!-- ── Name ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-name">{t('contact.field_name')}</label>
    <div class="contact-form__input-wrap">
      <input
        type="text"
        id="contact-name"
        name="name"
        class="contact-form__input"
        placeholder={t('contact.placeholder_name')}
        required
      />
    </div>
  </div>

  <!-- ── Email ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-email">{t('contact.field_email')}</label>
    <div class="contact-form__input-wrap">
      <input
        type="email"
        id="contact-email"
        name="email"
        class="contact-form__input"
        placeholder={t('contact.placeholder_email')}
        required
      />
    </div>
  </div>

  <!-- ── Subject ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-subject">{t('contact.field_subject')}</label>
    <div class="contact-form__input-wrap">
      <input
        type="text"
        id="contact-subject"
        name="subject"
        class="contact-form__input"
        placeholder={t('contact.placeholder_subject')}
        required
      />
    </div>
  </div>

  <!-- ── Message ── -->
  <div class="contact-form__group">
    <label class="contact-form__label" for="contact-message">{t('contact.field_message')}</label>
    <div class="contact-form__input-wrap">
      <textarea
        id="contact-message"
        name="message"
        class="contact-form__input contact-form__textarea"
        placeholder={t('contact.placeholder_message')}
        rows="5"
        required
      ></textarea>
    </div>
  </div>

  <!-- ── Honeypot (Hidden) ── -->
  <input type="text" name="favorite_color" style="display:none" tabindex="-1" autocomplete="off" />

  <!-- ── Turnstile Widget ── -->
  <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>

  <div class="contact-form__submit">
    <button type="submit" class="btn btn--primary" id="contact-submit-btn">
      {t('contact.btn_send_message')}
    </button>
  </div>

  <div id="contact-form-status" class="contact-form__status" aria-live="polite"></div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusDiv = document.getElementById('contact-form-status');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      
      // Basic client validation to check if Turnstile is complete
      const turnstileResponse = formData.get('cf-turnstile-response');
      if (!turnstileResponse) {
        statusDiv.textContent = 'Please complete the security check.';
        statusDiv.className = 'contact-form__status contact-form__status--error';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      statusDiv.textContent = '';
      statusDiv.className = 'contact-form__status';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (res.ok) {
          form.reset();
          if (window.turnstile) window.turnstile.reset();
          statusDiv.textContent = 'Message sent successfully! I will get back to you soon.';
          statusDiv.className = 'contact-form__status contact-form__status--success';
        } else {
          throw new Error(data.error || 'Failed to send message.');
        }
      } catch (err: any) {
        statusDiv.textContent = err.message || 'An error occurred. Please try again later.';
        statusDiv.className = 'contact-form__status contact-form__status--error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: 520px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contact-form__label {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .contact-form__input::placeholder,
  .contact-form__textarea::placeholder {
    color: var(--color-graphite);
    opacity: 0.6;
    font-weight: 300;
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus {
    border-color: var(--color-coral);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02), 0 0 0 3px rgba(244, 123, 137, 0.15);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form__submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2.5rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-cream);
    background: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, transparent 100%), var(--color-amber);
    border: 2px solid var(--color-amber);
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 2px 4px 0px rgba(212, 133, 58, 0.25), inset 0 1px 2px rgba(255,255,255,0.2);
    transition: all 0.3s var(--ease-spring);
  }

  .contact-form__submit:hover {
    transform: translateY(-2px) rotate(2deg);
    box-shadow: 2px 6px 0px rgba(212, 133, 58, 0.3), inset 0 1px 2px rgba(255,255,255,0.25);
  }

  .contact-form__submit:focus-visible {
    outline: 2px dashed var(--color-coral);
    outline-offset: 4px;
  }

  .contact-form__status {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
  }

  .contact-form__status--success {
    color: var(--color-sage);
  }

  .contact-form__status--error {
    color: var(--color-coral);
  }

  @media (max-width: 640px) {
    .contact-form__submit {
      width: 100%;
    }
  }
</style>
