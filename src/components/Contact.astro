---
/**
 * Contact.astro
 * ──────────────────────────────────────────
 * Minimal editorial contact form.
 * Pure Astro + HTML — no client JS needed.
 * All inputs have proper labels and focus states.
 */
---

<form
  class="contact-form"
  action="#"
  method="POST"
  aria-label="Contact form"
  id="contact-form"
>
  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-name">Name</label>
    <input
      class="contact-form__input"
      type="text"
      id="contact-name"
      name="name"
      placeholder="Your name"
      required
      autocomplete="name"
    />
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-email">Email</label>
    <input
      class="contact-form__input"
      type="email"
      id="contact-email"
      name="email"
      placeholder="you@example.com"
      required
      autocomplete="email"
    />
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-subject">Subject</label>
    <input
      class="contact-form__input"
      type="text"
      id="contact-subject"
      name="subject"
      placeholder="Commission, Collaboration, General Inquiry"
    />
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-message">Message</label>
    <textarea
      class="contact-form__textarea"
      id="contact-message"
      name="message"
      placeholder="Tell me about your project…"
      rows="5"
      required
    ></textarea>
  </div>

  <button class="contact-form__submit" type="submit">
    Send Message
  </button>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: 520px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contact-form__label {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .contact-form__input::placeholder,
  .contact-form__textarea::placeholder {
    color: rgba(0, 0, 0, 0.25);
    font-weight: 300;
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus {
    border-color: var(--color-coral);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02), 0 0 0 3px rgba(244, 123, 137, 0.15);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form__submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2.5rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-cream);
    background: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, transparent 100%), var(--color-amber);
    border: 2px solid var(--color-amber);
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 2px 4px 0px rgba(212, 133, 58, 0.25), inset 0 1px 2px rgba(255,255,255,0.2);
    transition: all 0.3s var(--ease-spring);
  }

  .contact-form__submit:hover {
    transform: translateY(-2px) rotate(2deg);
    box-shadow: 2px 6px 0px rgba(212, 133, 58, 0.3), inset 0 1px 2px rgba(255,255,255,0.25);
  }

  .contact-form__submit:focus-visible {
    outline: 2px dashed var(--color-coral);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .contact-form__submit {
      width: 100%;
    }
  }
</style>
