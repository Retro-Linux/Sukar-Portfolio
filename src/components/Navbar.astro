---
/**
 * Navbar.astro
 * ──────────────────────────────────────────
 * Sticky, minimal editorial navigation bar.
 * Left: text logo / branding.
 * Centre: page links (hidden on mobile, toggled via hamburger).
 * Right: social icon links.
 */

interface Props {
  /** The current URL path — used to highlight the active nav link */
  currentPath?: string;
  lang?: 'en' | 'ar';
}

const { currentPath = '/', lang = 'en' } = Astro.props;

import ThemeToggle from './ThemeToggle';
import { useTranslations } from '../i18n/utils';
const t = useTranslations(lang);

/* ── Nav links ──────────────────────────────── */
interface NavLink {
  label: string;
  href: string;
}

const links: NavLink[] = [
  { label: t('nav.work'),    href: '#work' },
  { label: t('nav.about'),   href: '#about' },
  { label: t('nav.contact'), href: '#contact' },
];

/* ── Social links ───────────────────────────── */
interface SocialLink {
  label: string;
  href: string;
  /** SVG path `d` attribute for a 24×24 viewBox icon */
  icon: string;
}

const socials: SocialLink[] = [
  {
    label: 'Instagram',
    href: 'https://instagram.com',
    icon: 'M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z',
  },
  {
    label: 'Behance',
    href: 'https://behance.net',
    icon: 'M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029h3.168zM20.59 14c-.107-1.547-1.314-2.51-2.588-2.51-1.39 0-2.393.983-2.588 2.51h5.176zM9.184 15.068c0 1.502-.749 2.636-2.476 2.636H3V6h3.969C8.879 6 10 7.402 10 8.88c0 1.131-.636 2.108-1.672 2.404v.047c1.369.23 2.378 1.263 2.378 2.764l-.522.973zM6.743 8.5H5.546v2.546h1.145c.907 0 1.528-.547 1.528-1.329 0-.795-.584-1.217-1.476-1.217zm.353 4.622H5.546v2.726h1.55c1.04 0 1.603-.599 1.603-1.403 0-.89-.625-1.323-1.603-1.323z',
  },
  {
    label: 'X / Twitter',
    href: 'https://x.com',
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
];

/** Check if a nav link is the current active page */
function isActive(href: string): boolean {
  if (href === '#work') return currentPath === '/' || currentPath === '/ar/' || currentPath.includes('#work');
  return currentPath.includes(href);
}

const targetLang = lang === 'en' ? 'ar' : 'en';
const targetUrl = lang === 'en' ? '/ar/' : '/';
---

<header class="navbar" id="site-navbar">
  <nav class="navbar__inner" aria-label="Main navigation">
    <!-- ─── Brand / Logo ────────────────────── -->
    <a href="/" class="navbar__brand" aria-label="Go to homepage">
      <span class="navbar__brand-name">Sukar's Sketchbook</span>
    </a>

    <!-- ─── Page Links (centre) ─────────────── -->
    <ul class="navbar__links" id="nav-links" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['navbar__link', { 'navbar__link--active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- ─── Social Icons & Tools (right) ────────────── -->
    <div class="navbar__socials">
      <a href={targetUrl} class="navbar__social-link navbar__lang-toggle" aria-label="Switch language">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>

      <ThemeToggle client:load />

      {socials.map((social) => (
        <a
          href={social.href}
          class="navbar__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d={social.icon} />
          </svg>
        </a>
      ))}

      <!-- ─── Mobile hamburger toggle ───────── -->
      <button
        class="navbar__toggle"
        id="nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span class="navbar__toggle-bar"></span>
        <span class="navbar__toggle-bar"></span>
      </button>
    </div>
  </nav>
</header>

<!-- ─── Mobile overlay menu ───────────────── -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav class="mobile-menu__inner" aria-label="Mobile navigation">
    <ul class="mobile-menu__links" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['mobile-menu__link', { 'mobile-menu__link--active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="mobile-menu__socials">
      {socials.map((social) => (
        <a
          href={social.href}
          class="mobile-menu__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d={social.icon} />
          </svg>
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  function initNavbar(): void {
    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('mobile-menu');
    const body = document.body;

    if (!toggle || !mobileMenu) return;

    function setMenuState(open: boolean): void {
      toggle!.setAttribute('aria-expanded', String(open));
      mobileMenu!.setAttribute('aria-hidden', String(!open));
      toggle!.classList.toggle('navbar__toggle--open', open);
      mobileMenu!.classList.toggle('mobile-menu--open', open);
      body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setMenuState(!isOpen);
    });

    // Close menu on link click
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false));
    });

    // Close on Escape
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') setMenuState(false);
    });

    // Close menu when lightbox opens (R6 — prevent overlapping overlays)
    document.addEventListener('open-lightbox', () => setMenuState(false));
  }

  // Run on initial load and after Astro view transitions
  initNavbar();
  document.addEventListener('astro:after-swap', initNavbar);
</script>

<style>
  /* ──────────────────────────────────────────
     Navbar — sticky header
     ────────────────────────────────────────── */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(255, 248, 240, 0.85); /* var(--color-cream) with opacity */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px dashed var(--color-tape);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--spacing-gutter);
    height: 64px;
  }

  /* ── Brand ──────────────────────────────── */
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.8rem;
    letter-spacing: 0.05em;
    text-transform: none;
    transition: opacity 0.2s ease;
  }

  .navbar__brand:hover {
    opacity: 0.7;
  }

  .navbar__brand-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-coral);
    flex-shrink: 0;
  }

  /* ── Desktop nav links ──────────────────── */
  .navbar__links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
  }

  .navbar__link {
    position: relative;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
  }

  .navbar__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--color-coral);
    transition: width 0.35s var(--ease-spring);
  }

  .navbar__link:hover::after,
  .navbar__link--active::after {
    width: 100%;
  }

  .navbar__link--active {
    color: var(--color-ink);
  }

  /* ── Social icons ───────────────────────── */
  .navbar__socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .navbar__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    border-radius: 4px;
    transition: color 0.2s ease, background-color 0.2s ease;
    color: var(--color-ink);
  }

  .navbar__social-link:hover {
    color: var(--color-sky);
    background-color: var(--color-ice-blue-dim);
  }

  /* ── Mobile toggle ──────────────────────── */
  .navbar__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    z-index: 110;
  }

  .navbar__toggle-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.35s var(--ease-out-expo), opacity 0.25s ease;
  }

  .navbar__toggle--open .navbar__toggle-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .navbar__toggle--open .navbar__toggle-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ──────────────────────────────────────────
     Mobile overlay menu
     ────────────────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 248, 240, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s var(--ease-out-expo), visibility 0.4s;
  }

  .mobile-menu--open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
  }

  .mobile-menu__link {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    transition: color 0.2s ease;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link--active {
    color: var(--color-coral);
  }

  .mobile-menu__socials {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .mobile-menu__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 6px;
    transition: color 0.2s ease, background-color 0.2s ease;
    color: var(--color-ink);
  }

  .mobile-menu__social-link:hover {
    color: var(--color-sky);
    background-color: var(--color-ice-blue-dim);
  }

  /* ──────────────────────────────────────────
     Responsive breakpoints
     ────────────────────────────────────────── */
  @media (max-width: 768px) {
    .navbar__links {
      display: none;
    }

    .navbar__social-link {
      display: none;
    }

    .navbar__toggle {
      display: flex;
    }
  }
</style>
