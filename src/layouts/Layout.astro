---
/**
 * Layout.astro
 * ──────────────────────────────────────────
 * Root layout for all pages.
 * Imports global CSS, Google Font (Outfit), Navbar, and footer.
 */
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** Page <title> */
  title: string;
  /** Meta description for SEO */
  description?: string;
  lang?: 'en' | 'ar';
  dir?: 'ltr' | 'rtl';
}

const {
  title,
  description = 'A curated portfolio of contemporary art and design.',
  lang = 'en',
  dir = 'ltr',
} = Astro.props;

const currentPath = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme Initialization Script (FOUC Prevention) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Global SEO & Open Graph Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfaf8" />

    <!-- Open Graph / Facebook / WhatsApp / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/favicon.svg', Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content="Sukar Sketchbook" />
    <meta property="twitter:description" content="Explore my latest artwork and digital paintings." />
    <meta property="twitter:image" content={new URL('/favicon.svg', Astro.url)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- CDN Preconnects for Lighthouse optimization -->
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />

    <!-- Google Fonts: Caveat, Fraunces, Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Page-specific head elements (e.g. LCP preloads) -->
    <slot name="head" />
  </head>

  <body>
    <Navbar currentPath={currentPath} lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  /* ── Main content spacing ──────────────── */
  #main-content {
    min-height: calc(100dvh - 64px - 80px); /* viewport – navbar – footer */
  }
</style>

