# ---------------------------------------------------------
# PORTFOLIO ENVIRONMENT VARIABLES TEMPLATE
# ---------------------------------------------------------
# Copy this file to .env and fill in your actual values.
# IMPORTANT: Never commit your actual .env file to GitHub!
# You must also add all of these variables to your Vercel Dashboard.

# 1. Sanity CMS (Database for Artwork & Messages)
PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="your_sanity_api_token"

# 2. Resend (For receiving inquiry emails)
RESEND_API_KEY="re_123456789_xxxxxxxxxxxxxxxxxxxxxx"
CONTACT_EMAIL="sara.w.2005.m@gmail.com"

# 3. Nodemailer / Gmail (For sending auto-replies to users)
# This is a 16-character App Password from Google, NOT your normal password.
# No quotes, no spaces. Example: abcdefghijklmnop
GMAIL_APP_PASSWORD="your_16_letter_app_password"

# 4. Cloudflare Turnstile (Spam Protection)
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# 5. Upstash Redis (Rate Limiting)
# Make sure there are NO extra quotes when pasting into Vercel!
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_long_upstash_token_here"
